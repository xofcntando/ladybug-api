API_KEYS=change-me-key1,another-key2
STORAGE_DIR=./storage
MAX_FILE_MB=25
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_MODEL=

# Our own quota: requests per API key per rolling 24h. 0 = unlimited, RATE_LIMIT_ENABLED=0 turns it off.
# Small-by-default downloads: 128 kbps MP3, 360p MP4 (fast, a few MB).
AUDIO_KBPS=128
VIDEO_QUALITY_DEFAULT=360

DAILY_REQUEST_LIMIT=3000
RATE_LIMIT_ENABLED=1

# Official free media APIs. NASA, Wikimedia Commons and Internet Archive need no key;
# Pexels turns on the pexels source in /v1/free/* (free key: pexels.com/api).
PEXELS_API_KEY=
MEDIA_MAX_MB=50

# Metadata caches, minutes.
MUSICINFO_CACHE_MINUTES=60

# Optional: KnightBot is a last-resort YouTube fallback. Its default public key is
# shared (3000 requests/day for everyone), so we cap our own usage.
KNIGHT_API_KEY=
KNIGHT_DAILY_LIMIT=3000
KNIGHT_HOURLY_LIMIT=190
KNIGHT_MINUTE_LIMIT=25

# yt-dlp only (default). Set to 'knight' to allow KnightBot as a last-resort download backend.
YT_BACKEND=ytdlp
